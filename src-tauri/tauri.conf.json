{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMate",
  "version": "1.0.0",
  "identifier": "com.agentmate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8102",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentMate",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/agentmate-local-agent"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQTU5NTdCMDQ5MDZDMgpSV1RDQmttd1Yxa0tDekJkWkE3K004c0wvbXFiT2dPdUlmNEFZRTNCMkhSWlRUanh3ZXpiYTlTKwo="
    }
  }
}
