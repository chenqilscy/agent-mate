# Rust build output (huge) and Tauri-generated schemas.
/target/
/gen/schemas/
# Sidecar binary — a ~17MB build artifact rebuilt from backend/ (see
# backend/build_sidecar.py); don't bloat the repo with it.
/binaries/
# Updater signing keys — PRIVATE key must never be committed; the .pub is a
# redundant `tauri signer generate` artifact (the pubkey is already inlined in
# tauri.conf.json), so ignore both.
.updater-key*
