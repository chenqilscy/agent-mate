{
  "name": "agentmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite",
    "dev:console": "vite --config vite.console.config.ts",
    "dev:server": "backend\\.venv\\Scripts\\python.exe server\\main.py",
    "dev:local-agent": "backend\\.venv\\Scripts\\python.exe backend\\main.py",
    "build": "tsc -b && vite build && pnpm build:console",
    "build:console": "tsc -p tsconfig.console.json --noEmit && vite build --config vite.console.config.ts",
    "check:console-dist": "node scripts/check-console-dist.mjs",
    "test:frontend": "vitest run",
    "test:regression": "pnpm test:frontend && backend\\.venv\\Scripts\\python.exe -m unittest discover -s backend/tests/regression -p \"test_*.py\" && tsc -b --pretty false",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "validate:v1-rc": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/validate-v1-rc.ps1",
    "release:validate": "node scripts/validate-desktop-release.mjs",
    "gen:api": "openapi-typescript http://localhost:8101/openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "antd": "6.5.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.5.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
