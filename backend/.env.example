# WorkBuddy backend configuration.
# Copy to backend/.env and fill in. The API key NEVER leaves the backend.

# OpenAI-compatible endpoint. Works with DeepSeek / GLM / Kimi / MiniMax / OpenAI etc.
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional: server bind
HOST=127.0.0.1
PORT=8000

# Optional: sandbox workspace root (default: backend/workspace)
# WORKBUDDY_WORKSPACE=

# Optional connector credentials (forwarded ONLY to that connector's subprocess).
# GitHub connector: a personal access token (github.com → Settings → Developer
# settings → Personal access tokens). Needs Node/npx on PATH to launch the server.
# GITHUB_TOKEN=ghp_xxx

# Telegram connector (built-in, no Node needed): a bot token from @BotFather.
# TELEGRAM_CHAT_ID is optional — a default target for send_message (a numeric
# chat id, or @channelusername). Discover a chat id via the get_updates tool
# after the other party messages your bot.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=
